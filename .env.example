# OpenAI Tunnel
CONTROL_PLANE_TUNNEL_ID=tunnel_0123456789abcdef0123456789abcdef
CONTROL_PLANE_API_KEY=sk-your-runtime-api-key

# Search platform credentials
# Keep the Google JSON on ONE LINE. Single quotes are recommended.
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"search-console-mcp@your-project-id.iam.gserviceaccount.com","token_uri":"https://oauth2.googleapis.com/token"}'
BING_API_KEY=your-bing-api-key

# Public IndexNow verification key. Leave empty if unused.
INDEXNOW_KEY=

# Optional: used ONLY by OpenAI Tunnel control-plane traffic.
# SOCKS5_UPSTREAM=socks5://user:password@proxy.example.com:1080

# Build/runtime versions
TUNNEL_CLIENT_VERSION=v0.0.14
MCP_IMAGE_TAG=0.5.1-tunnel-0.0.14
