# SOCKS5 upstream used ONLY by OpenAI Tunnel control-plane traffic.
# Example: socks5://user:password@proxy.example.com:1080
SOCKS5_UPSTREAM=socks5://127.0.0.1:1080

# OpenAI Tunnel identity. Not a secret, but deployment-specific.
CONTROL_PLANE_TUNNEL_ID=tunnel_0123456789abcdef0123456789abcdef

# Public IndexNow verification key. Leave empty if you do not use IndexNow.
INDEXNOW_KEY=

# Pinned OpenAI tunnel-client release used during Docker build.
TUNNEL_CLIENT_VERSION=v0.0.14

# Local image tag.
MCP_IMAGE_TAG=0.5.0-tunnel-0.0.14
