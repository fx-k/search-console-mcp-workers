# /etc/search-console-mcp/search-console-mcp.env
# chmod 600 and keep this file out of Git.

GOOGLE_SERVICE_ACCOUNT_FILE=/etc/search-console-mcp/google-service-account.json
BING_API_KEY=replace-with-bing-api-key
INDEXNOW_KEY=replace-with-indexnow-key

CONTROL_PLANE_TUNNEL_ID=tunnel_0123456789abcdef0123456789abcdef
MCP_COMMAND="/usr/bin/node /opt/search-console-mcp/src/runtime/stdio.js"
HEALTH_LISTEN_ADDR=127.0.0.1:8080
